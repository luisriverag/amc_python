package eltreeD4;

{$I 'Design\ElPack.inc'}
{$R *.RES}
{$R 'Source\Checkctl.res'}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $00400000}
{$DESCRIPTION 'EldoS Visual Components'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  vcl40;

contains
  ElVCLUtils in 'Source\ElVCLUtils.pas',
  ElStrUtils in 'Source\ElStrUtils.pas',
  ElTools in 'Source\ElTools.pas',
  ElContBase in 'Source\ElContBase.pas',
  ElList in 'Source\ElList.pas',
  ElStack in 'Source\ElStack.pas',
  ElHeader in 'Source\ElHeader.pas',
  ElTree in 'Source\ElTree.pas',
  ElScrollBar in 'Source\ElScrollBar.pas',
  ElHintWnd in 'Source\ElHintWnd.pas';

end.
