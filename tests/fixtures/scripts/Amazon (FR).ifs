program Amazon_FR;
uses
  StringUtils1, ScorEpioNCommonScript;

const
  AmazonUrl = 'https://www.amazon.fr/';
  AmazonSearch = 'https://www.amazon.fr/dp/';
var
  MovieName, Address : string;
  i, premiereExecution: Integer;
  listeResultat: TStringList;

//------------------------------------------------------------------------------
// RECUPERE LES RESULTATS AMAZON.FR
//------------------------------------------------------------------------------

procedure imageAmazon(title : String);
var
  adresseRecherche, Line : String;
  StartPos: Integer;
begin
  PickTreeClear;
  adresseRecherche := AmazonSearch+UrlEncode(title);
  Line := GetPage(adresseRecherche);
  if (pos('<link rel="canonical" href="https://www.amazon.fr', Line) > 0) then
  begin
      StartPos := pos('<link rel="canonical" href="https://www.amazon.fr', Line);
      delete(Line, 1, StartPos);
      StartPos := pos('www.amazon.fr', Line);
      delete(Line, 1, StartPos);
      StartPos := pos('/', Line);
      delete(Line, 1, StartPos);
      StartPos := pos('"', Line);
      Line := copy(Line, 1, StartPos-1);
      recupInfo(AmazonUrl+Line);
  end else
  begin
      showmessage('EAN non trouvé');
  end;
  //recupInfo('http://www.amazon.fr/Inception-Blu-ray-Leonardo-DiCaprio/dp/B003WJREA0/ref=sr_1_1?s=dvd&ie=UTF8&qid=1358672797&sr=1-1');
end;

function CleanText(Text: string): string;
begin
  Result := CleanTextWithBr(Text, False);
end;

function CleanTextWithBr(Text: string; KeepBr: Boolean): string;
begin
  if KeepBr then
  begin
    Text := StringReplace(Text, #13#10, '');
    Text := StringReplace(Text, '<br>', #13#10);
  end;
  HtmlRemoveTags(Text);
  Text := UTF8Decode(Text);
  HtmlDecode(Text);
  if not KeepBr then
  begin
    Text := StringReplace(Text, #13#10, ' ');
  end;
  Text := Trim(Text);
  while Pos('  ', Text) > 0 do
  begin
    Text := StringReplace(Text, '  ', ' ');
  end;
  Text := StringReplace(Text, ' , ', ', ');
  Result := Text;
end;

//------------------------------------------------------------------------------
// RECUPERE LES INFOS
//------------------------------------------------------------------------------

procedure recupInfo(Adresse : String);
var
   Value, Value2, Value3, Line, Line2: String;
   StartPos, i: Integer;
begin
   Line := GetPage(Adresse);
   //Line := UTF8Decode(Line);
   Line2 := Line;
   StartPos := pos('id="imgTagWrapperId"', Line2);
   delete(Line2, 1, StartPos-1);
   StartPos := pos('src="', Line2);
   delete(Line2, 1, StartPos-1);
   Value := findInfo('src="', '"', Line2,'0');
// Jaquette DVD
   if CanSetPicture then
     GetPicture(Value);
// Titre Traduit
   if CanSetField(fieldTranslatedTitle) then
   begin
   if pos('product-title-word-break">', Line) > 0 then
      begin
        Line2 := Line;
        StartPos := pos('product-title-word-break">', Line2);
        delete(Line2, 1, StartPos-1);
        StartPos := pos('</span>', Line2);
        Line2 := copy(Line2, 1, StartPos+6);
        Line2 := UTF8Decode(Line2);
        Line2 := DecodeUTF(Line2);
        Value := formatTitre(findInfo('product-title-word-break">', '</span>', Line2,'0'),GetOption('Casse Choisie'));
        MonSetField(fieldTranslatedTitle, Value);
      end;
   end;
// Acteurs
   if CanSetField(fieldActors) then
   begin
   if pos('>Acteurs', Line) > 0 then
      begin
        Line2 := Line;
        StartPos := pos('>Acteurs', Line2);
        delete(Line2, 1, StartPos-1);
        MonSetField(fieldActors, formatTitre(UTF8Decode(findInfo('<span>', '</span>', Line2,'0')),GetOption('Casse Choisie')));
      end;
   end;
// Réalisateur
   if CanSetField(fieldDirector) then
   begin
      if pos('<span class="a-text-bold">RÃ©alisateur', Line) > 0 then
      begin
        Line2 := Line;
        StartPos := pos('<span class="a-text-bold">RÃ©alisateur', Line2);
        delete(Line2, 1, StartPos-1);
        MonSetField(fieldDirector, formatTitre(UTF8Decode(findInfo('<span>', '</span>', Line2,'0')),GetOption('Casse Choisie')));
      end;
   end;
// Date de parution
   if CanSetField(fieldYear) then
   begin
   if pos('<span class="a-text-bold">Date de sortie', Line) > 0 then
      begin
        Line2 := Line;
        StartPos := pos('<span class="a-text-bold">Date de sortie', Line2);
        delete(Line2, 1, StartPos-1);
        Value := findInfo('<span>', '</span>', Line2,'0');
        MonSetField(fieldYear, copy(Value,length(Value)-4,length(Value)));
      end;
   end;
// Editeur
   if CanSetField(fieldProducer) then
   begin
      if pos('>Studio', Line) > 0 then
      begin
        Line2 := Line;
        StartPos := pos('>Studio', Line2);
        delete(Line2, 1, StartPos-1);
        MonSetField(fieldProducer, UTF8Decode(findInfo('<span>', '</span>', Line2,'0')));
      end;
   end;
// Langue
   if CanSetField(fieldLanguages) then
   begin
      if pos('<span class="a-text-bold">Langue', Line) > 0 then
      begin
        Line2 := Line;
        StartPos := pos('<span class="a-text-bold">Langue', Line2);
        delete(Line2, 1, StartPos-1);
        Line2 := UTF8Decode(findInfo('<span>', '</span>', Line2,'0'));
        MonSetField(fieldLanguages, Line2);
      end;
   end;
// Sous-titre
   if CanSetField(fieldSubtitles) then
   begin
      if pos('>Sous-titre', Line) > 0 then
      begin
        Line2 := Line;
        StartPos := pos('>Sous-titre', Line2);
        delete(Line2, 1, StartPos-1);
        Line2 := UTF8Decode(findInfo('<span>', '</span>', Line2,'0'));
        MonSetField(fieldSubtitles, Line2);
      end;
      if pos('>DoublÃ©Â', Line) > 0 then
      begin
        Line2 := Line;
        StartPos := pos('>DoublÃ©Â', Line2);
        delete(Line2, 1, StartPos-1);
        Line2 := UTF8Decode(findInfo('<span>', '</span>', Line2,'0'));
        MonSetField(fieldSubtitles, Line2);
      end;
   end;
// Nombre de Disques
   if CanSetField(fieldDisks) then
   begin
      if pos('<span class="a-text-bold">Nombre de disques', Line) > 0 then
      begin
        Line2 := Line;
        StartPos := pos('<span class="a-text-bold">Nombre de disques', Line2);
        delete(Line2, 1, StartPos-1);
        MonSetField(fieldDisks, findInfo('<span>', '</span>', Line2,'0'));
      end;
   end;
// Durée
   if CanSetField(fieldLength) then
   begin
      if pos('<span class="a-text-bold">DurÃ©e', Line) > 0 then
      begin
        Line2 := Line;
        StartPos := pos('<span class="a-text-bold">DurÃ©e', Line2);
        delete(Line2, 1, StartPos-1);
        Value := findInfo('<span>', '</span>', Line2,'0');
        Value := CleanText(Value);
        Value2 := TextBefore(Value, ' heure', '');
        Value3 := TextBetween(Value, 'et ', ' min');
        i := StrToInt(Value2, 0) * 60 + StrToInt(Value3, 0);
        MonSetField(fieldLength, IntToStr(i));
      end;
   end;
// Format
   if CanSetField(fieldMediaType) then
   begin
      if pos('<span class="a-text-bold">Format', Line) > 0 then
      begin
        Line2 := Line;
        StartPos := pos('<span class="a-text-bold">Format', Line2);
        delete(Line2, 1, StartPos-1);
        MonSetField(fieldMediaType, UTF8Decode(findInfo('<span>', '</span>', Line2,'0')));
      end;
   end;

// Synopsis
   if CanSetField(fieldDescription) then
   begin
      if pos('<span>Synopsis', Line) > 0 then
      begin
        Line2 := Line;
        StartPos := pos('<span>Synopsis', Line2);
        delete(Line2, 1, StartPos-1);
        Value := UTF8Decode(deleteMultiSpace(findInfo('<p>', '</p>', Line2, '4')));
        HTMLDecode(Value);
        HTMLRemoveTags(Value);
        Value := DecodeUTF(Value);
        Value := StringReplace(Value, '		', RC);
        Value := StringReplace(Value, RC+RC, RC);
        Value := deleteTab(Value);
        MonSetField(fieldDescription, Value);
      end;
   end;

// Description
   if CanSetField(fieldComments) then
   begin
      if pos('<div id="productDescription"', Line) > 0 then
      begin
        Line2 := Line;
        StartPos := pos('<div id="productDescription"', Line2);
        delete(Line2, 1, StartPos-1);
        Value := UTF8Decode(deleteMultiSpace(findInfo('<p>', '</p>', Line2, '4')));
        HTMLDecode(Value);
        HTMLRemoveTags(Value);
        Value := DecodeUTF(Value);
        Value := StringReplace(Value, '		', RC);
        Value := StringReplace(Value, RC+RC, RC);
        Value := deleteTab(Value);
        MonSetField(fieldComments, Value);
      end;
   end;

// Adresse Web
   if CanSetField(fieldURL) then
      SetField(fieldURL, Adresse);

// Note
  if CanSetField(fieldRating) or CanSetField(fieldComments) then
  begin
   Value := TextBetween(Line, 'IMDb</i><strong>', '</strong>');
   MonSetField(fieldRating, Value);
  end;

// Affichage des titres si original et traduit identique
  titreDouble(GetOption('Titre en double'));

end;

//------------------------------------------------------------------------------
// SUPPRIME LES ACCENTS
//------------------------------------------------------------------------------

function supprimeAccents(NomFilm : String) : String;
begin
     NomFilm := supprimeLesAccents(NomFilm);
     delete(NomFilm, pos(' - ',NomFilm), length(NomFilm));
     if (pos(', ',NomFilm) > 0) then
        delete(NomFilm, 1, pos(', ',NomFilm)+1);
     if (pos('(',NomFilm) > 0) then
        delete(NomFilm, pos('(',NomFilm), length(NomFilm));
     if (pos(':',NomFilm) > 0) then
        delete(NomFilm, pos(':',NomFilm), length(NomFilm));
     result := trim(NomFilm);
end;

Function DecodeUTF(Description : String) : String;
var
  Value2 : string;
begin
  Value2 := StringReplace2(Description, '&#xE0;','à', false, true);
  Value2 := StringReplace2(Value2, '&#xE7;','ç', false, true);
  Value2 := StringReplace2(Value2, '&#xE8;','è', false, true);
  Value2 := StringReplace2(Value2, '&#xE9;','é', false, true);
  Value2 := StringReplace2(Value2, '&#xEA;','ê', false, true);
  Value2 := StringReplace2(Value2, RC, '', false, true);
  Value2 := StringReplace2(Value2, '&#39;', '''', false, true);

  result := trim(Value2);
end;


//------------------------------------------------------------------------------
// PROGRAMME PRINCIPAL
//------------------------------------------------------------------------------

begin
  if CheckVersion(3,5,0) then
  begin
    if Input('amazon.fr', 'Entrez le code-barre (EAN) du DVD :', MovieName) then
      begin
          imageAmazon(MovieName);

          //if MovieName <> '' then
          //   recupInfo(MovieName)
          //else
          //   exit;
      end;
  end else
    ShowMessage('This script requires a newer version of Ant Movie Catalog (at least the version 3.5.0)');
end.